#
# Recommended configuration for scripts/hive-start.sh — the settings the published numbers were measured with.
# Format: KEY=value, one per line, no quotes or shell expansion. A value already set in the environment or in
# the file named by HIVE_LOCAL_ENV wins over this file (precedence: environment > HIVE_LOCAL_ENV > this file).
# Every engine switch is documented in docs/configuration.md.

# ---- Launcher ----------------------------------------------------------------------------------------------
# HIVE_CKPT has no default: the checkpoint directory (config.json, *.safetensors, encoding/, inference/).
HIVE_IMAGE=eke-hive:latest
HIVE_CONTAINER=hived
HIVE_GPU=0
HIVE_PORT=8430
# VRAM expert cache in MiB, used only when HIVE_CACHE_FIT is off (below it is on: the cache takes the free VRAM minus a reserve).
HIVE_CACHE_MB=68000
HIVE_MAX_CTX=262144
HIVE_MAX_CHUNK=16384
HIVE_CPU_THREADS=16
HIVE_MAX_BATCH=8
HIVE_DAEMON_ARGS=--gpu-share 0 --promote 8 --prefill-tile 3 --decoder-replay
# Host RAM (GiB) that must be available before a RAM-mode start (the daemon pins ~480 GB; keep this below the installed RAM — the start script clamps it to MemTotal - 8).
HIVE_RAM_WAIT_GB=480

# ---- Engine switches (adopted; each one measured in docs/performance.md) ------------------------------------
HIVE_EARLY_STREAM=1
HIVE_ENGRAM_PAR=1
HIVE_IDX_MSUB_ACTUAL=1
HIVE_PREFIX_SHARE=1
# Server side: one extra boundary chunk only for conversations whose tail is replaced between turns (docs/configuration.md, API server settings)
HIVE_PREFIX_ADAPTIVE=1
# The cache warm after a prefill rides on the following decode steps (<= 32 experts per step) instead of one synchronous upload (step 19: 4-stream decode 17.0 -> 21.5 tok/s, 21.2 with the yields below; no decoder stall)
HIVE_WARM_DEFER=32
# Layer-boundary yields also inside small prefills (step 20): the decoders' longest stall during another user's follow-up turn 1.07 -> 0.59 s, 4-stream decode -1.5%
HIVE_LAYER_YIELD_SMALL=1
# A layer yield also admits a request of up to 16,384 rows when it is at most half of what the paused forward still has to do; that request's
#   own forward yields once more for decode only. 85K-row prompt + 12K-row request 3 s later + a running decoder (layer_yield_check, two runs
#   each): request 14.6 -> 4.4 s to the first token, the long prompt 13.9 -> 18.2 s, mean of the two 14.3 -> 11.3 s; decoder's longest stall
#   1.83 -> 2.05 s (5.13 s without the second yield level)
HIVE_LAYER_YIELD_MID=16384
HIVE_PREFIX_EXTRA_CHUNKS=0
HIVE_DEFER_CKPT=1
HIVE_CKPT_ASYNC=1
HIVE_CKPT_DELTA=1
HIVE_PREFILL_PAUSE_PROMOTE=1
HIVE_TAIL_SPLIT=1
HIVE_CACHE_REUSE_STAGE=1
HIVE_MTP_CACHE=1
HIVE_PHASE_SCORE=1
HIVE_PROMOTE_SCORE=1
HIVE_TILE_GROUP_GEMM=1
HIVE_HC_FUSE2=1
HIVE_MX_GEMM=1
HIVE_IDX_TC=1
HIVE_IMAGE_CKPT=1
HIVE_GROUPED_PREFILL=1
HIVE_PREFILL_HOST_TILES=1
HIVE_BATCH_PREFILL=1
HIVE_DMA_FRAC_PREFILL=0.7
HIVE_DECODE_FUSED=1
HIVE_DECODE_ATTN_FUSED=1
HIVE_CACHE_POLICY=seq
HIVE_DECODE_COPY_PRIO=1
HIVE_DECODE_FUSED2=1
HIVE_DECODE_FUSED2_STAGES=4
HIVE_DECODE_HOST_FAST=1
HIVE_PREFILL_HOST_MB=1920
HIVE_DECODE_ATTN2=1
HIVE_CPU_GEMV2=1
HIVE_DECODE_ROUTER3=1
HIVE_DECODE_SPARSE3=1
HIVE_DECODE_QKV3=1
HIVE_DECODE_HCMIX3=1
HIVE_DECODE_CPU_FIRST=1
HIVE_MTP_GATE2=1
HIVE_CPU_MULTIROW2=1
HIVE_CPU_UNPACK2=1
HIVE_DECODE_FUSED3=1
HIVE_CACHE_FIT=1
HIVE_ENGRAM_ALIAS=1
HIVE_CACHE_ELASTIC=1
HIVE_DECODE_EARLY_ROUTE=1
HIVE_SHORT_DMA_CAP=32
HIVE_MTP_GATE3=1
HIVE_MTP_VERIFY2=1
# Cache-aware routing (decode): routers biased toward experts already in VRAM, λ 0.1, top-2 always kept (docs/configuration.md).
#   Real-chat benchmark with the expert deferral below (tools/bench_chat.py, 12 prompts): c1 53.8 → 76.9 tok/s, c4 81.1 → 124.0,
#   c8 100.2 → 173.0; quality suite 172 → 175 / 179 (McNemar p = 0.375; long-context items identical, outputs unchanged on all 35).
HIVE_CACHE_PRIOR=0.1
# Expert deferral (decode): CPU misses ranked 3rd or lower in their row are added one layer later instead of being waited for (same measurement).
HIVE_DECODE_DEFER=1
# Not adopted: HIVE_DECODE_SKIP_MISS=0.1 on top — c1 +8 %, c2-c32 within ±1 %, decode after 17-54K prompts 4-12 % lower; quality 176 / 179 (p = 1).
HIVE_MTP_VERIFY2_FUSED=1
HIVE_LOAD_PAR=1
HIVE_LOAD_PREFAULT=1
HIVE_LAYER_YIELD=1
HIVE_PREFILL_TAIL_SHORT=1
HIVE_PREFILL_SHORT_ADAPT=1
HIVE_PREFILL_SMALL=256
HIVE_PREFILL_MULTI_TAIL_SHORT=1
HIVE_PREFETCH_SCALE=1
HIVE_CKPT_PINNED_POOL_MB=4096
HIVE_CKPT_HISTORY=4
HIVE_STAGING=96
HIVE_PREFETCH=96
HIVE_VIT_CACHE_MB=2048

# CUDA virtual memory management for device allocations, so that level-3 sleep (HIVE_SLEEP_LEVEL=3) can release the dense
#   weights too; all published numbers were measured with it on
HIVE_SLEEP_VMM=1

# ---- Optional (off here; see docs/configuration.md) ----------------------------------------------------------
# Keep the Engram value tables on the NVMe instead of RAM (−183 GB resident, −1 to −6 % throughput):
#   HIVE_ENGRAM_SSD=1
# Monitoring logs read by tools/hive_monitor.py and tools/hive_daily_report.py:
#   HIVE_TRACE_CACHE=1, HIVE_PROFILE=64, HIVE_TRACE_MTP=1, HIVE_PREFILL_PROF=1, HIVE_EXPERT_TRACE=/out/logs/expert-trace.bin
