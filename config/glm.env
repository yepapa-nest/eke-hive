# Recommended configuration for the GLM-5.3-Flash family (hived_glm). The launcher uses it automatically when HIVE_CKPT is a GLM
# checkpoint (or set HIVE_CONFIG=config/glm.env). The DeepSeek engine switches in config/hive.env do not apply to this family.
# Measurements: docs/glm.md. The A/B numbers in the comments below were taken on the build of their step; the current speed is
# in docs/benchmarks.md.
HIVE_IMAGE=eke-hive:latest
HIVE_CONTAINER=hived
HIVE_GPU=0
HIVE_PORT=8430
# expert cache: sized to the free VRAM after the session pool (minus the reserve)
HIVE_CACHE_FIT=1
HIVE_CACHE_RESERVE_MB=3000
# used only when HIVE_CACHE_FIT is off
HIVE_CACHE_MB=60000
# Context: 262,144 positions. Only addresses are reserved for that; sequence KV memory follows use (16K kept per sequence, more taken in
#   4K steps from the expert-cache tail and given back when the sequence is reset — GlmEngine::kv_reserve). Measured against
#   65536 (which allocated the whole KV up front): session pool 4 × 1370 → 4 × 458 MiB, cache 4420 → 4693 slots, c1 67.8 → 68.1 tok/s,
#   c4 87.0 → 90.1; 200K / 250K prompts 52.3 / 64.6 s to the first token; quality 157 → 158 / 163, long ruler 64K/128K/250K 21 / 21.
HIVE_MAX_CTX=262144
# 16K blocks; prompts up to 4 blocks (64K rows) run layer-major (HIVE_GLM_PREFILL_TILES, default 4) in borrowed cache slots
HIVE_MAX_CHUNK=16384
# CPU expert pool: 32 threads (16 per NUMA node). A/B (hived, c1 chat ×12, interleaved twice): 32 → c1 46.8 / 47.1 tok/s and
#   86 GB/s in the CPU expert phase, 24 → 45.9 / 45.3 and 79 GB/s (more cores also mean more heat: Tctl 80-88 °C at 24 during decode)
HIVE_CPU_THREADS=32
# 8 sequences per decode step (the decode kernels take M <= 8) and, with two or more streams, their drafts verified in one step
#   (HIVE_MTP_BATCH). Real-chat benchmark (4 base runs vs 2 each): 4 -> 8 alone c8 93.2 -> 127.8 tok/s and c8 first token 23 -> 0.7-0.9 s
#   (the queue behind 4 seats is gone); with HIVE_MTP_BATCH on top c2 66.6 -> 79.5, c8 125.7; c1 68.2 -> 67.6, c4 88.5 -> 86.4 (84.8 / 87.9 —
#   inside the base runs' spread)
HIVE_MAX_BATCH=8
HIVE_MTP_BATCH=1
# Layer-boundary yields inside a prefill (the same switches as config/hive.env): short requests are admitted and running decoders step while a
#   long prompt prefills. 60K-row prompt + 64-row requests at 1/3/5/8 s + a running decoder (layer_yield_check): first two requests 14.0 / 12.5 ->
#   0.65 / 0.59 s, decoder's longest stall 14.4 -> 1.6 s, the long prompt 14.5 -> 16.5 s (the last two requests found the 4 seats taken)
HIVE_LAYER_YIELD=1
HIVE_LAYER_YIELD_SMALL=1
# mid-size requests admitted at layer yields too (DeepSeek step 23). 96K-token prompt with a 2K and a 12K request arriving 8 s into its
#   prefill (two runs each): the 2K request's first token 18.9 / 18.6 -> 2.9 / 2.9 s, the 12K one 5.4 / 5.6 s, the long prompt 22.7 / 22.6 ->
#   31.0 / 31.2 s (it waited for both)
HIVE_LAYER_YIELD_MID=16384
# start only when this much RAM is available (a previous daemon must have released its pinned memory first; GLM keeps
#   ~358 GiB resident after start)
HIVE_RAM_WAIT_GB=390
# checkpoint: set HIVE_CKPT in the environment or in HIVE_LOCAL_ENV, e.g. HIVE_CKPT=/models/GLM-5.3-Flash-NVFP4
# Z.ai FP8 tensors (DSA attention projections, shared experts) — scripts/glm-fetch-fp8.py
HIVE_GLM_FP8_DIR=/models/GLM-5.3-Flash-zai-fp8
# next-layer expert prefetch: 1 expert per MoE layer (A/B: 0 → 33.5 tok/s, 1 → 34.1, 2 → 30.7)
HIVE_GLM_PREFETCH=1
# MTP draft head over 65,536 frequent tokens (tools/build_draft_vocab.py --balance --lang en: OpenAssistant oasst2 English assistant
#   messages + the NSMC Korean corpus; THIRD_PARTY_NOTICES §5). The verify step still scores against the full lm_head, so outputs are
#   unchanged. Measured with an earlier list built from ShareGPT answers (coverage of chat answers 99.4 % English / 99.8 % Korean; this
#   list 98.5 % / 98.4 %): real chat, interleaved twice, c1 69.4 -> 71.4, c4 98.1 -> 104.6 tok/s, c2 / c8 unchanged
HIVE_GLM_DRAFT_VOCAB=/hive/config/glm-draft-vocab-64k.bin
# MTP gate: online step-cost and acceptance tables (hive/mtp_gate.h) — the fixed table of the default gate is DeepSeek's
HIVE_MTP_GATE2=1
# drop verify-cost samples taken while the expert cache is still warming after a prefill (the GLM runtime reports them like graph captures)
HIVE_MTP_GATE3=1
# prompt-prefix sharing across conversations (boundary snapshots — the same switches as config/hive.env). Measured with an
#   8.6K-token system prompt: a new conversation with the same system prompt 0 → 8,625 cached tokens, prefill 5.8 → 0.5 s, answers correct;
#   a prompt that differs at the start stays at 0 cached tokens
HIVE_PREFIX_SHARE=1
HIVE_PREFIX_ADAPTIVE=1
# prompt checkpoint after the first token, sharing the previous image's exact rows (the same switches as config/hive.env). Measured
#   motivation (2026-10-05 service traffic): the synchronous full copy before the first token added 746 ms to the mean TTFT (1,097 ms at 64K+)
HIVE_DEFER_CKPT=1
HIVE_CKPT_DELTA=1
# RAM budget for conversations evicted from the VRAM session pool (hived --host-session-mb, default 32768). A 145K-token GLM conversation
#   keeps ~3 GB, so 32 GB held about ten. Twelve 145K conversations, then the first one continues: 37.0 s (state dropped, prefilled
#   again) -> 1.6 s (145,137 tokens reused)
HIVE_HOST_SESSION_MB=98304
# cache-aware routing (HIVE_CACHE_PRIOR=λ — decode routing biased toward VRAM-resident experts, top-2 always kept; Skliar et al., TMLR 2025,
#   arXiv 2412.00099). A/B (hived, c1 chat ×12, interleaved twice; quality suite 163 items, A/A baseline run twice):
#   λ 0 → c1 47.8 tok/s, hit 86.7 %, 160 / 158 (A/A) · λ 0.1 → 61.3 tok/s (+28 %), hit 96.3 %, 158 · λ 0.2 → 63.5 tok/s, 97.9 %, 157
#   (one long-context item flipped). λ 0.1: the quality difference equals the baseline's own run-to-run difference.
HIVE_CACHE_PRIOR=0.1
# expert deferral (HIVE_GLM_DEFER — CPU misses ranked 3rd or lower are computed while the GPU goes on and added one MoE layer later; after
#   KTransformers' Expert Deferral, SOSP'25, idea only). A/B on top of λ 0.1 (interleaved twice): c1 60.7 / 60.4 → 64.0 / 63.2
#   tok/s (+5 %), waited CPU time per 3-row verify 6.8-7.2 → 2.7-3.0 ms; quality 157 / 157 vs 157-160 for λ 0.1 alone (the one long-context
#   item that flipped once passed on the re-run).
HIVE_GLM_DEFER=1
# CUDA virtual memory management for device allocations, so that level-3 sleep (HIVE_SLEEP_LEVEL=3) can release the dense
#   weights too; all published numbers were measured with it on
HIVE_SLEEP_VMM=1
