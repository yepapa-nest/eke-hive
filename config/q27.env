# Starting configuration for the Qwen3.8-27B family (hived_q27 / hived_q27_cpu). The launcher uses it automatically when HIVE_CKPT is a
# Qwen3.8-27B checkpoint (config.json model_type "qwen3_5"), or set HIVE_CONFIG=config/q27.env. docs/q27.md describes the family.
# Measured on the GPU daemon (RTX PRO 6000, 600 W, 2026-10-11 — docs/q27.md "Final"). Code defaults that need no key here: GDN prefill in
#   WY form v2 (HIVE_Q27_GDN_WY=0 = the fp32 chunk scan), drafter rows 33..64 in one GEMM pass (HIVE_Q27_DRAFT_GT=0 = off), grouped drafter
#   attention (HIVE_Q27_DF_ATTN_GRP=0 = off), tensor-core decode attention (HIVE_Q27_ATTN4=0 = off), session-image memory freed off the engine
#   thread, KV-buffer recycling (cap 1/16 of the VRAM left after the weights, none below 8 GB).
HIVE_IMAGE=eke-hive:latest
HIVE_CONTAINER=hived
HIVE_GPU=0
HIVE_PORT=8430
# GPU: total VRAM cap for the process (startup; unset = the free VRAM). Layers that do not fit run on the CPU (docs/q27.md "placement").
# HIVE_Q27_VRAM_MB=16000
# GPU prefill rows per forward (work buffers ≈ 0.36 MB per row) · CPU-only prefill chunk
HIVE_Q27_CHUNK=2048
HIVE_Q27_CPU_CHUNK=2048
# Speculative decoding (lossless — every draft is verified by the full model): DFlash2 drafter when HIVE_Q27_DFLASH points at the
#   z-lab Qwen3.8-27B-DFlash2 checkpoint (draft length 7; hive-start mounts it read-only), otherwise the checkpoint's MTP block.
# HIVE_Q27_DFLASH=/path/to/Qwen3.8-27B-DFlash2
HIVE_Q27_DFLASH_FP8=1
HIVE_Q27_DRAFT_VOCAB=/hive/config/q27-draft-vocab-64k.bin
HIVE_Q27_MTP_INPUT=post
# swapped tensor-core GEMV for every decode / verify row count (bit-identical across row counts)
HIVE_Q27_SW=1
# Quantization defaults follow measured no-regression against bf16 (2026-10-10). RTX PRO 6000 at 600 W, non-thinking ruler / qa / code:
#   bf16 35/72/20 = 127 (two identical runs) · prefill quant (W8A8/W4A4 prefill) 34/71/20 = 125 — 1 item per category, within
#   error (allowed) · NVFP4 decode copies of the FP8 matrices (HIVE_Q27_W4=1, decode only: HIVE_Q27_W4_PREFILL=0) on top of
#   prefill quant 34/72/20 = 126 (better than prefill quant alone; tool 21/22 and session 13/13 equal to bf16) → on.
#   (W4 copies used by the W4A4 prefill as well gave 33/70/20 = 123 — that combination stays off.) c1 135 → 160 tok/s per request.
HIVE_Q27_PREFILL_QUANT=1
HIVE_Q27_W4=1
HIVE_Q27_W4_PREFILL=0
HIVE_CACHE_MB=0
HIVE_MAX_CTX=262144
HIVE_MAX_CHUNK=2048
HIVE_CPU_THREADS=32
HIVE_MAX_BATCH=16
HIVE_MTP_GATE2=1
HIVE_MTP_GATE3=1
HIVE_DEFER_CKPT=1
HIVE_MTP_BATCH=1
HIVE_LAYER_YIELD=1
HIVE_LAYER_YIELD_SMALL=1
# weights 18.6 GiB (CPU) + embeddings 2.5 GiB + KV / states per session
HIVE_RAM_WAIT_GB=48
# session images kept in host RAM beyond the pool (hived --host-session-mb; scripts/lib.sh scales it down on smaller hosts: ≤ 25 % of RAM − need − 8 GiB)
HIVE_HOST_SESSION_MB=98304
HIVE_PREFIX_SHARE=1
HIVE_PREFIX_ADAPTIVE=1
