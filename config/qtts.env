# Qwen3-TTS 12Hz 1.7B CustomVoice streaming text-to-speech (config model_type "qwen3_tts") — libhive_qtts.so behind
#   server/speech/tts_server.py: WebSocket /ws/speak (PCM16 24 kHz chunks) and GET /health (docs/qtts.md). Started by scripts/hive-start.sh
#   (which hands this family to scripts/qtts-start.sh). Measured footprint 3,968 MiB with these settings (docs/qtts-validation-20261018.md).
HIVE_IMAGE=eke-hive:latest
HIVE_CONTAINER=hive_qtts
HIVE_GPU=0
HIVE_PORT=8443
HIVE_BIND=127.0.0.1
# talker positions per request: prompt (text tokens + 11 control rows, + instruct) + generated frames (12.5 per second of audio);
#   2048 = about 2:40 of audio per request. The KV cache is 112 KiB per position.
HIVE_QTTS_MAX_SEQ=2048
# a live speech model runs beside a large model on the same card
HIVE_START_WAIT_OTHERS=0
