# Qwen3-ASR 1.7B speech recognition (config model_type "qwen3_asr") — libhive_qasr.so behind server/speech/asr_server.py, an
#   SGLang-compatible /generate API (docs/qasr.md). Started by scripts/hive-start.sh (which hands this family to scripts/qasr-start.sh).
#   Measured footprint 5,040 MiB with these settings (docs/qasr-validation-20261018.md).
HIVE_IMAGE=eke-hive:latest
HIVE_CONTAINER=hive_qasr
HIVE_GPU=0
HIVE_PORT=8444
HIVE_BIND=127.0.0.1
HIVE_QASR_SERVED_NAME=asr
# concurrent requests decoded together (KV slots); more requests queue
HIVE_QASR_MAX_SEQS=2
# positions per request: prompt incl. audio tokens (13 per second of audio) + generated text
HIVE_MAX_CTX=2048
# a live speech model runs beside a large model on the same card
HIVE_START_WAIT_OTHERS=0
