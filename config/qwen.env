# Starting configuration for the Qwen3.8-Flash-Next family (hived_qwen). The launcher uses it automatically when HIVE_CKPT is a
# Qwen3.8-Flash-Next checkpoint (config.json model_type "qwen4_exp"), or set HIVE_CONFIG=config/qwen.env. docs/qwen.md describes the family.
# ⚠️ NOT MEASURED YET: unlike config/hive.env and config/glm.env, no value here comes from an A/B run of this family — they are the GLM
#   family's daemon-level choices carried over where the mechanism is the same, and the family's own switches at their defaults. Each will
#   get its measured verdict (docs/qwen.md "Validation plan": whole card first, then a 50 % and a 20 % VRAM budget).
HIVE_IMAGE=eke-hive:latest
HIVE_CONTAINER=hived
HIVE_GPU=0
HIVE_PORT=8430
# VRAM budget (startup only): unset = the whole card — every routed expert (24,576 NVFP4 records, 63.4 GiB) fits the cache and decode routes on
#   the device. Set e.g. 48000 or 19000 (MiB) for a smaller footprint: the expert cache gets what the budget leaves after the weights, the session
#   pool and the reserve; the rest of the experts stay in pinned RAM and run on the CPU when missed (the GLM family's path).
# HIVE_QWEN_VRAM_MB=48000
# expert cache: sized to the free VRAM after the session pool (minus the reserve), capped at the expert count and by HIVE_QWEN_VRAM_MB
HIVE_CACHE_FIT=1
HIVE_CACHE_RESERVE_MB=3000
HIVE_CACHE_MB=60000
# Context 262,144 (the checkpoint's max_position_embeddings). Only addresses are reserved; KV memory follows use (QwenEngine::kv_reserve).
HIVE_MAX_CTX=262144
# 16K rows per prefill call; up to 4 calls' rows run layer-major while some expert is not resident (HIVE_QWEN_PREFILL_TILES)
HIVE_MAX_CHUNK=16384
HIVE_CPU_THREADS=32
# 16 sequences per decode step (2026-10-10, 600 W: c16 TTFT 7.7 s → 243 ms, tput 273 → 369 tok/s; experts stay 100 % resident)
HIVE_MAX_BATCH=16
# per-sequence KV reserved up front (rows); KV beyond it grows on demand and is trimmed back when the session goes idle (hived KV reclaim).
#   2048 keeps the 16-session pool small beside the full expert cache (fn_final600c: prefill 8K/32K/64K TTFT 799/3220/6477 ms).
HIVE_QWEN_KV_BASE=2048
HIVE_MTP_BATCH=1
HIVE_MTP_GATE2=1
HIVE_MTP_GATE3=1
# PLE n-gram table (47.7 GiB): ram (pinned host memory) or ssd (rows read on demand from the checkpoint file — docs/qwen.md)
HIVE_QWEN_PLE=ram
# Layer-boundary yields inside a prefill (daemon switches, as in config/glm.env)
HIVE_LAYER_YIELD=1
HIVE_LAYER_YIELD_SMALL=1
HIVE_LAYER_YIELD_MID=16384
# start only when this much RAM is available: pinned experts 63.4 GiB + NUMA half records 63.4 GiB + PLE 47.7 GiB (ram mode) + embeddings
HIVE_RAM_WAIT_GB=240
# prompt-prefix sharing, deferred checkpoint, conversation RAM budget (daemon switches, as in config/glm.env)
HIVE_PREFIX_SHARE=1
HIVE_PREFIX_ADAPTIVE=1
HIVE_PREFIX_EXTRA_CHUNKS=0
HIVE_PREFIX_FIRST_TURN=seen
HIVE_DEFER_CKPT=1
HIVE_CKPT_DELTA=1
HIVE_HOST_SESSION_MB=98304
HIVE_SLEEP_VMM=1
# checkpoint: set HIVE_CKPT in the environment or in HIVE_LOCAL_ENV, e.g. HIVE_CKPT=/models/nvidia-Qwen3.8-Flash-Next-NVFP4
# Quantization defaults follow measured no-regression against the official checkpoint (bf16 dense), 2026-10-10: quality within
#   each category's binomial standard error AND total not lower, oracle tokens identical. Low-bit speed is a separate 3/2-bit track.
#   int8 dense (group 128), RTX PRO 6000 at 600 W, non-thinking: bf16 ruler 34/35 · qa 71/80 · code 20/20 · tool 22/22 · session 13/13 (total 160/170,
#   two identical runs) vs int8 33/35 · 73/80 · 20/20 · 22/22 · 13/13 (161/170) → pass. bf16: HIVE_QWEN_DENSE8=0.
#   The 64K draft vocabulary only changes MTP drafts — every token is still verified by the full head.
HIVE_QWEN_DENSE8=int8
# int8 MTP verify head as well: 33/35 · 72/80 · 20/20 · 22/22 · 13/13 (total 160/170 = bf16) → pass; the fastest passing setting.
HIVE_QWEN_DENSE8_HEAD=1
HIVE_QWEN_DRAFT_VOCAB=/hive/config/q27-draft-vocab-64k.bin
