# Copyright (c) 2026 The Eke Hive Authors
# Gemma 4 12B Unified (int4 QAT, text path) with its MTP assistant — hived_gemma (docs/gemma.md). A small real-time chat model: short
#   prompts, two or three conversations at once, low first-token latency.
HIVE_IMAGE=eke-hive:latest
HIVE_CONTAINER=hive_gemma
HIVE_GPU=0
HIVE_PORT=8441
HIVE_CACHE_MB=0
# 128K: besides live voice turns it answers chat while a bigger model sleeps (the full layers keep 8 KiB per token, the sliding ones
#   only their window — a 128K conversation holds ~1.5 GiB of KV, beyond the pool it moves to HIVE_GEMMA_HOST_KV_MB)
HIVE_MAX_CTX=131072
HIVE_MAX_CHUNK=1024
HIVE_GEMMA_CHUNK=1024
HIVE_MAX_BATCH=4
HIVE_CPU_THREADS=8
# the Frozen-KV MTP assistant (a separate checkpoint): set HIVE_GEMMA_ASSISTANT to its directory (inside the container); unset = no drafter
HIVE_GEMMA_MTP_K=3
# MTP gate: online step-cost and acceptance tables (hive/mtp_gate.h) — the fixed table of the default gate is DeepSeek's (its confidence
#   buckets and 38 ms step put a 6.5 ms Gemma step's drafts at "no gain" and drafting never started; measured 2026-10-18 mtp 0/0)
HIVE_MTP_GATE2=1
HIVE_MTP_GATE3=1
# two or three live conversations at once: speculate on the batch too (verify_batch / mtp_draft_batch)
HIVE_MTP_BATCH=1
# sliding-window pages kept behind the window (prefix reuse within the recent turns)
HIVE_GEMMA_SWA_KEEP=2048
# KV pages beyond the VRAM pool go to mapped host memory (never an out-of-memory)
HIVE_GEMMA_HOST_KV_MB=8192
HIVE_DEFER_CKPT=1
# runtime reserve inside the VRAM limit (sizes the KV pool down by this much): the prompt-checkpoint scratch is taken from it (a slot of
#   256-512 MiB for a long conversation), and with every graph captured at startup the default 512 left only 224 MiB after ready
#   (measured 2026-10-18 under a 13,000 MiB limit) — every long conversation's image was then copied synchronously
HIVE_CACHE_RESERVE_MB=1024
HIVE_HOST_SESSION_MB=16384
HIVE_PREFIX_SHARE=1
# a first turn saves a shared snapshot at the end of its system block (the daemon skips the cut once that snapshot exists): one-token turn
#   judgments and new conversations repeat the same system prompt — without it every judgment prefilled its whole ~270-token prompt
#   (measured 2026-10-18, 39-66 ms). A cut costs Gemma one short extra chunk and a small snapshot.
HIVE_PREFIX_FIRST_TURN=1
HIVE_PREFIX_ADAPTIVE=1
HIVE_RAM_WAIT_GB=12
# a live chat model runs beside a large model on the same card: start without waiting for the other GPU daemons to exit
HIVE_START_WAIT_OTHERS=0
