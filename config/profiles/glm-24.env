# HIVE_MODEL=glm HIVE_VRAM_GB=24 — start values from docs/vram-footprint.md (§2 lean set, §3.1 per card); the sweep refines them.
# Lean set, no MTP and no images (§3.1: lean −3.5 GB, 320 slots without MTP, 409 also without images).
HIVE_MAX_CHUNK=4096
HIVE_MAX_BATCH=1
HIVE_MAX_CTX=32768
HIVE_GLM_PREFILL_TILES=1
HIVE_MTP_BATCH=0
HIVE_GLM_MTP_K=0
HIVE_DAEMON_ARGS=--max-sessions 2 --no-vision
HIVE_CACHE_RESERVE_MB=500
