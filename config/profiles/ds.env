# DeepSeek-V4.1-Flash: model data of the HIVE_MODEL=ds profiles (scripts/lib.sh hive_apply_profile). KEY=value, values taken literally, no
#   trailing comments. The size files <ds>-<GB>.env are read first and may override a value here.
HIVE_PROFILE_FAMILY=deepseek
HIVE_PROFILE_CKPT_NAMES=DeepSeek-V4.1-Flash
# checkpoint on disk, GiB (du on the reference machine, 2026-10-10)
HIVE_PROFILE_DISK_GB=476
# host RAM in use, GiB: RAM mode ~480 · Engram value tables on the NVMe ~300 (README, measured)
HIVE_PROFILE_RAM_GB=480
HIVE_PROFILE_RAM_GB_SSD=300
# the switch that keeps the 203 GB Engram value tables on disk, and its values
HIVE_PROFILE_SSD_KEY=HIVE_ENGRAM_SSD
HIVE_PROFILE_SSD_ON=1
HIVE_PROFILE_SSD_OFF=0
