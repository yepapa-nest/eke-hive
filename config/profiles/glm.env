# GLM-5.3-Flash: model data of the HIVE_MODEL=glm profiles (scripts/lib.sh hive_apply_profile). KEY=value, values taken literally, no
#   trailing comments. The size files <glm>-<GB>.env are read first and may override a value here.
HIVE_PROFILE_FAMILY=glm
HIVE_PROFILE_CKPT_NAMES=GLM-5.3-Flash-NVFP4
# checkpoint on disk, GiB (NVFP4 191; the optional Z.ai FP8 tensors HIVE_GLM_FP8_DIR add 9)
HIVE_PROFILE_DISK_GB=191
# host RAM in use, GiB (README: ~385 GB, measured); no table to move to disk
HIVE_PROFILE_RAM_GB=385
HIVE_PROFILE_SSD_KEY=
