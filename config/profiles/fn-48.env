# HIVE_MODEL=fn HIVE_VRAM_GB=48 — start values from docs/vram-footprint.md (§2 lean set, §3.1 per card); the sweep refines them.
# Shipped configuration of the family fits this card (docs/vram-footprint.md §3.1); the measured overrides follow. HIVE_VRAM_LIMIT_MB is derived
#   from HIVE_VRAM_GB (none for 96 = the whole card); the expert cache fills what is left (HIVE_CACHE_FIT).
# 36.6 % of the experts resident — the hybrid route (qwen_engine.h) runs here. Every 4th non-resident
#   expert of a layer is read over PCIe by the GPU instead of the CPU (short benchmark pass: c1/c4/c8 125.9/172.9/220.1 → 129.7/179.8/227.2),
#   and only steps of ≤ 8 rows are captured as CUDA graphs (each graph's device memory comes out of the expert cache).
HIVE_QWEN_HYB_PCIE=4
HIVE_QWEN_GRAPH_ROWS=8
