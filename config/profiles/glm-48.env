# HIVE_MODEL=glm HIVE_VRAM_GB=48 — start values from docs/vram-footprint.md (§2 lean set, §3.1 per card); the sweep refines them.
# Expert cache first: the shipped set spends 6.5 GiB on 16,384-row work buffers and 8 × 300 MiB of KV mapped up
#   front per pool sequence; at 48 GB that left 730 slots (31 % of decode routings on the CPU, c4 = c1).
#   · --max-chunk 8192 with layer-major blocks: the MoE runs once over all rows of a call, work buffers 3.25 GiB instead of 6.5
#     (426,000 B/row, docs/vram-footprint.md §1.3).
#   · KV base 4096 positions per sequence (was max_chunk): longer sequences grow in 4K steps from the cache tail as before (kv_reserve).
#   Measured (short pass: warm c4, max_tokens 300, then c1/c4/c8 + 64K): 730 → 1091 slots · c1 41.2 → 45.2 · c4 41.0 → 47.3 ·
#   c8 45.9 → 54.2 tok/s · 64K TTFT 22.0 → 21.8 s.
# Prefill and MTP set (short benchmark pass = warm c4, max_tokens 150, c1/c4/c8, then a 64K prompt and an image request; shipped →
#   this set: 1091 → 1428 slots · c1 42.6 → 46.0 · c4 42.7 → 48.3 · c8 49.5 → 53.5 tok/s · 64K TTFT 21.88 → 16.24 s):
#   · 9 layer-major blocks (73,728 rows): the 64K bench prompt (67,510 rows) runs in one pass instead of 65,536 + 1,974 rows, and the short
#     second pass streamed ~10K expert records again.
#   · HIVE_GLM_PREFILL_ROWBLOCK=8192: the per-expert prefill scratch is bounded by 8192 rows (~235 MB) instead of the most rows one expert got
#     in the call (+1.1 GB measured at 64K before), so the reserve drops 3000 → 1500 MiB. Measured peak with an image request right after the
#     64K prompt: 95,974 of 97,887 MiB used (1,913 MiB left).
#   · HIVE_MTP_BATCH=0: MTP drafts only for a single stream. With 8 streams the batched verify ran up to 32 rows per step through a 9 % cache
#     (many more CPU misses) and its 8 snapshot parts took 3.4 GiB. Alone: c1 43.7 · c4 43.6 · c8 51.3 (1317 slots) vs 42.6/42.7/49.5.
HIVE_MAX_CHUNK=8192
HIVE_GLM_PREFILL_TILES=9
HIVE_GLM_PREFILL_ROWBLOCK=8192
HIVE_GLM_KV_BASE=4096
HIVE_CACHE_RESERVE_MB=1500
HIVE_MTP_BATCH=0
# HIVE_GLM_MTP_LEND=1 — with HIVE_MTP_BATCH=0 the NextN layer drafts only for a single stream, so while
#   several streams decode its 288 FP8 routed experts (6.75 GiB) are idle: after 16 multi-stream steps they are freed and the expert cache
#   grows into the space (+~510 slots); after 8 single-stream draft calls the cache tail is given back and the experts are copied back from a
#   pinned host copy (~0.32 s, once). ≥ 2 s between switches. Drafts are off while lent (plain decode — same output). Measured v1 → v2
#   (short benchmark pass, back to back): 32 GB c4/c8 29.3/32.6 → 39.2/44.0 · 48 GB 48.4/55.1 → 54.8/64.2 · 72 GB 70.3/87.5 → 74.0/96.6 tok/s; c1 unchanged.
HIVE_GLM_MTP_LEND=1
# CPU pool chunking (HIVE_GLM_CPU_CHUNKS=4: up to 4 chunks per worker, floor 8 rows, instead of 1 chunk / 32 rows — the 1-2 CPU
#   experts per layer left workers 48-68 % busy). Measured on this profile (lend on, back to back, two orders): c1/c4/c8 47.1/56.4/65.9 and
#   45.4/55.9/66.4 vs 45.2/54.8/64.5 and 45.9/55.3/65.5 (default runs span c4 54.7-55.3, c8 63.5-65.5): c4/c8 +2 %, c1 within noise.
HIVE_GLM_CPU_CHUNKS=4
