# HIVE_MODEL=ds HIVE_VRAM_GB=16 — start values from docs/vram-footprint.md (§2 lean set, §3.1 per card); the sweep refines them.
# Lean set, no DSpark and no images (§3.1: lean 64 slots → 169 without MTP and images).
HIVE_MAX_CHUNK=4096
HIVE_MAX_BATCH=1
HIVE_MAX_CTX=32768
HIVE_PREFILL_HOST_TILES=0
HIVE_BATCH_PREFILL=0
HIVE_STAGING=8
HIVE_CACHE_ELASTIC=0
HIVE_MTP_BATCH=0
HIVE_DAEMON_ARGS=--gpu-share 0 --promote 8 --prefill-tile 1 --decoder-replay --max-sessions 2 --no-mtp --no-vision
HIVE_CACHE_RESERVE_MB=500
