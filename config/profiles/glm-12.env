# HIVE_MODEL=glm HIVE_VRAM_GB=12 — start values from docs/vram-footprint.md (§2 lean set, §3.1 per card); the sweep refines them.
# Lean set, no MTP and no images; layers move to the CPU (§3.2, about 25 of 45) — chosen by the GLM family under HIVE_VRAM_LIMIT_MB
#   (HIVE_GLM_GPU_LAYERS=N forces it).
HIVE_MAX_CHUNK=4096
HIVE_MAX_BATCH=1
HIVE_MAX_CTX=32768
HIVE_GLM_PREFILL_TILES=1
HIVE_MTP_BATCH=0
HIVE_GLM_MTP_K=0
HIVE_DAEMON_ARGS=--max-sessions 2 --no-vision
HIVE_CACHE_RESERVE_MB=500
