# HIVE_MODEL=glm HIVE_VRAM_GB=72 — start values from docs/vram-footprint.md (§2 lean set, §3.1 per card); the sweep refines them.
# Expert cache first — the same knobs as glm-48.env (see the reasoning there): --max-chunk 8192 with 8 layer-major
#   blocks (same 65,536 rows per prefill call, work buffers 3.25 GiB instead of 6.5) and a 4096-position KV base per sequence.
#   Reserve stays 3000 MiB (config/glm.env). Measured (same short pass as glm-48): 2550 → 2911 slots · c1 54.7 → 58.3 · c4 69.9 → 74.8 ·
#   c8 86.0 → 91.6 tok/s · 64K TTFT 21.05 → 20.74 s.
HIVE_MAX_CHUNK=8192
# Prefill and MTP set — the glm-48 reasoning: 9 blocks (73,728 rows: the 64K bench prompt in one pass), per-expert prefill
#   scratch bounded at 8192 rows (HIVE_GLM_PREFILL_ROWBLOCK) so the reserve drops 3000 → 1500 MiB, and MTP drafts for a single stream only
#   (HIVE_MTP_BATCH=0: no 8-part verify snapshots, fewer CPU misses per step). Short benchmark pass (warm c4, max_tokens 150, c1/c4/c8, 64K, image after):
#   2911 → 3248 slots · 54.4/65.6/81.2 → 59.6/69.4/86.6 tok/s · 64K TTFT 20.72 → 15.85 s · peak 95,952 of 97,887 MiB used.
HIVE_GLM_PREFILL_TILES=9
HIVE_GLM_PREFILL_ROWBLOCK=8192
HIVE_CACHE_RESERVE_MB=1500
HIVE_MTP_BATCH=0
HIVE_GLM_KV_BASE=4096
# HIVE_GLM_MTP_LEND=1 — with HIVE_MTP_BATCH=0 the NextN layer drafts only for a single stream, so while
#   several streams decode its 288 FP8 routed experts (6.75 GiB) are idle: after 16 multi-stream steps they are freed and the expert cache
#   grows into the space (+~510 slots); after 8 single-stream draft calls the cache tail is given back and the experts are copied back from a
#   pinned host copy (~0.32 s, once). ≥ 2 s between switches. Drafts are off while lent (plain decode — same output). Measured v1 → v2
#   (short benchmark pass, back to back): 32 GB c4/c8 29.3/32.6 → 39.2/44.0 · 48 GB 48.4/55.1 → 54.8/64.2 · 72 GB 70.3/87.5 → 74.0/96.6 tok/s; c1 unchanged.
HIVE_GLM_MTP_LEND=1
