# Qwen3.8-27B: model data of the HIVE_MODEL=27b profiles (scripts/lib.sh hive_apply_profile). KEY=value, values taken literally, no
#   trailing comments. The size files <27b>-<GB>.env are read first and may override a value here.
HIVE_PROFILE_FAMILY=q27
HIVE_PROFILE_CKPT_NAMES=Qwen3.8-27B-NVFP4
# checkpoint on disk, GiB (du on the reference machine, 2026-10-10)
HIVE_PROFILE_DISK_GB=22
# host RAM, GiB (config/q27.env HIVE_RAM_WAIT_GB — estimate); dense model, no table to move to disk
HIVE_PROFILE_RAM_GB=48
HIVE_PROFILE_SSD_KEY=
