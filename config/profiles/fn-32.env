# HIVE_MODEL=fn HIVE_VRAM_GB=32 — start values from docs/vram-footprint.md (§2 lean set, §3.1 per card); the sweep refines them.
# Shipped configuration of the family fits this card (docs/vram-footprint.md §3.1); the measured overrides follow. HIVE_VRAM_LIMIT_MB is derived
#   from HIVE_VRAM_GB (none for 96 = the whole card); the expert cache fills what is left (HIVE_CACHE_FIT).
# 11.4 % of the experts resident — hybrid route (qwen_engine.h); only steps of ≤ 8 rows are captured as CUDA graphs:
#   with graphs for every shape their device memory shrank the expert cache (c4/c8 98.4/116.9 vs host route 107.6/128.1); with this
#   setting 109.0/128.9 and c1 85.5 (host route 76.6), short benchmark pass.
HIVE_QWEN_GRAPH_ROWS=8
