# HIVE_MODEL=ds HIVE_VRAM_GB=0 — start values from docs/vram-footprint.md (§2 lean set, §3.1 per card); the sweep refines them.
# CPU only (hived_ds_cpu, HIVE_GPU=none derived): the Engram tables stay in RAM or are read through the checkpoint mapping (page cache /
#   NVMe) — the CPU engine's switch, chosen by installed RAM. RAM needs measured 2026-10-09: experts 289 + Engram 203 GB + dense ~10 GB resident.
HIVE_PROFILE_RAM_GB=505
HIVE_PROFILE_RAM_GB_SSD=305
HIVE_PROFILE_SSD_KEY=HIVE_DS_CPU_ENGRAM
HIVE_PROFILE_SSD_ON=mmap
HIVE_PROFILE_SSD_OFF=ram
