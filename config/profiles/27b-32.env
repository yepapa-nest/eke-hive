# HIVE_MODEL=27b HIVE_VRAM_GB=32 — every layer, the lm_head and the DFlash2 drafter on the GPU; KV in VRAM while the KV tier's budget lasts
#   (~100K positions), beyond it in pinned host memory up to the full context (engine KV tier, default on under a VRAM cap).
#   Max batch and sessions as at the other 27B sizes (16).
HIVE_MAX_CTX=262144
