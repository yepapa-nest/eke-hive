# HIVE_MODEL=27b HIVE_VRAM_GB=16 — the engine places what fits: the DFlash2 drafter and the lm_head first, then as many layers as
#   fit on the GPU (the rest, with their KV, run on the CPU); the GPU layers' KV in VRAM while the KV tier's budget lasts, then in pinned host
#   memory up to the full context. Max batch and sessions as at the other 27B sizes (16); vision on.
HIVE_MAX_CTX=262144
