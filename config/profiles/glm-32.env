# HIVE_MODEL=glm HIVE_VRAM_GB=32 — start values from docs/vram-footprint.md (§2 lean set, §3.1 per card); the sweep refines them.
# Lean set (§3.1: shipped −6.7 GB, lean 341 slots).
# Layer-major prefill on: HIVE_GLM_PREFILL_TILES=1 made a 64K prompt 17 chunked passes that each streamed the
#   routed experts again (177,434 records, TTFT 108.5 s vs 22 s at 48 GB). The tiles cost no startup VRAM (borrowed from the cache tail,
#   GlmEngine::layer_major_span lowers the span to what the tail holds). 8 blocks of 4096 = 32,768 rows per call keep the non-elastic
#   prefill scratch (≤ 28,680 B per row routed to one expert ≈ 0.9 GB worst case) inside the 1,700 MiB reserve.
HIVE_MAX_CHUNK=4096
HIVE_MAX_BATCH=1
HIVE_MAX_CTX=32768
# HIVE_GLM_PREFILL_ROWBLOCK=8192 with more blocks per call. The row block bounds the non-elastic per-expert prefill
#   scratch at 8192 rows (~235 MB; it grew with the span before), so a longer span fits the same reserve; layer_major_span still lowers it to
#   what the cache tail holds. 9 blocks (36,864 rows) fit the cache tail that is left after the earlier sessions' KV in the full benchmark
#   order; 12 blocks were lowered to a 45,056 + 4,096 split there (3 streaming passes, 64K TTFT 27.99 s). With 9 blocks: 64K TTFT 22.38 s
#   (28.19 s before the row block), decode unchanged.
HIVE_GLM_PREFILL_TILES=9
HIVE_GLM_PREFILL_ROWBLOCK=8192
HIVE_MTP_BATCH=0
HIVE_DAEMON_ARGS=--max-sessions 2
HIVE_CACHE_RESERVE_MB=1700
# HIVE_GLM_MTP_LEND=1 — with HIVE_MTP_BATCH=0 the NextN layer drafts only for a single stream, so while
#   several streams decode its 288 FP8 routed experts (6.75 GiB) are idle: after 16 multi-stream steps they are freed and the expert cache
#   grows into the space (+~510 slots); after 8 single-stream draft calls the cache tail is given back and the experts are copied back from a
#   pinned host copy (~0.32 s, once). ≥ 2 s between switches. Drafts are off while lent (plain decode — same output). Measured v1 → v2
#   (short benchmark pass, back to back): 32 GB c4/c8 29.3/32.6 → 39.2/44.0 · 48 GB 48.4/55.1 → 54.8/64.2 · 72 GB 70.3/87.5 → 74.0/96.6 tok/s; c1 unchanged.
HIVE_GLM_MTP_LEND=1
