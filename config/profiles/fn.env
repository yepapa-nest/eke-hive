# Qwen3.8-Flash-Next: model data of the HIVE_MODEL=fn profiles (scripts/lib.sh hive_apply_profile). KEY=value, values taken literally, no
#   trailing comments. The size files <fn>-<GB>.env are read first and may override a value here.
HIVE_PROFILE_FAMILY=qwen
HIVE_PROFILE_CKPT_NAMES=Qwen3.8-Flash-Next-NVFP4 nvidia-Qwen3.8-Flash-Next-NVFP4
# checkpoint on disk, GiB (du on the reference machine, 2026-10-10)
HIVE_PROFILE_DISK_GB=124
# host RAM, GiB (config/qwen.env HIVE_RAM_WAIT_GB: pinned experts 63.4 + NUMA half records 63.4 + PLE 47.7 + embeddings — estimate);
#   the PLE table on disk saves its 47.7
HIVE_PROFILE_RAM_GB=240
HIVE_PROFILE_RAM_GB_SSD=192
# the switch that keeps the 47.7 GB PLE n-gram table on disk, and its values
HIVE_PROFILE_SSD_KEY=HIVE_QWEN_PLE
HIVE_PROFILE_SSD_ON=ssd
HIVE_PROFILE_SSD_OFF=ram
