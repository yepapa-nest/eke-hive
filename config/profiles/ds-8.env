# HIVE_MODEL=ds HIVE_VRAM_GB=8 — start values from docs/vram-footprint.md (§2 lean set, §3.1 per card); the sweep refines them.
# Lean set, no DSpark and no images; the weights do not fit: layers move to the CPU (§3.2, about 30 of 40) — chosen automatically
#   under HIVE_VRAM_LIMIT_MB (Model::plan_gpu_layers; HIVE_DS_GPU_LAYERS=N forces it). Layer placement is not measured on a GPU yet.
HIVE_MAX_CHUNK=4096
HIVE_MAX_BATCH=1
HIVE_MAX_CTX=32768
HIVE_PREFILL_HOST_TILES=0
HIVE_BATCH_PREFILL=0
HIVE_STAGING=8
HIVE_CACHE_ELASTIC=0
HIVE_MTP_BATCH=0
HIVE_DAEMON_ARGS=--gpu-share 0 --promote 8 --prefill-tile 1 --decoder-replay --max-sessions 2 --no-mtp --no-vision
HIVE_CACHE_RESERVE_MB=500
HIVE_DS_PLACE_CHUNK=4096
HIVE_DS_MIN_SLOTS=32
